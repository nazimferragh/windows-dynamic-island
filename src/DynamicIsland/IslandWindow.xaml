<Window x:Class="DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DynamicIsland.Controls"
        Title="Dynamic Island"
        Width="760" Height="370"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryText" Color="#8CFFFFFF" />
        <SolidColorBrush x:Key="TertiaryText" Color="#59FFFFFF" />
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#1C1C1E" />

        <!-- Filled, Mac-style transport glyphs. -->
        <Geometry x:Key="PlayGlyph">M 1,0 L 13,7.5 L 1,15 Z</Geometry>
        <Geometry x:Key="PauseGlyph">M 0,0 H 4.5 V 15 H 0 Z M 8.5,0 H 13 V 15 H 8.5 Z</Geometry>
        <Geometry x:Key="NextGlyph">M 0,0 L 10,6 L 0,12 Z M 10,0 L 20,6 L 10,12 Z</Geometry>
        <Geometry x:Key="PreviousGlyph">M 20,0 L 10,6 L 20,12 Z M 10,0 L 0,6 L 10,12 Z</Geometry>
        <Geometry x:Key="NoteGlyph">M 6,0 L 16,0 L 16,11.5 A 2.8,2.8 0 1 1 13.2,8.8 L 13.2,4 L 8.8,4 L 8.8,13.5 A 2.8,2.8 0 1 1 6,10.8 Z</Geometry>
        <!-- Magnifier outline (drawn as a stroked path). -->
        <Geometry x:Key="SearchGlyph">M 6.5,0 A 6.5,6.5 0 1 0 6.5,13 A 6.5,6.5 0 1 0 6.5,0 M 11.5,11.5 L 17,17</Geometry>
        <Geometry x:Key="SpeakerGlyph">M 0,5 L 3,5 L 8,1 L 8,15 L 3,11 L 0,11 Z M 10.5,4 A 5,5 0 0 1 10.5,12 M 10.5,6.5 A 2.4,2.4 0 0 1 10.5,9.5</Geometry>
        <!-- Down arrow into a tray. -->
        <Geometry x:Key="DownloadGlyph">M 4.5,0 L 7.5,0 L 7.5,5 L 11,5 L 6,11 L 1,5 L 4.5,5 Z M 0,13 L 12,13 L 12,15.5 L 0,15.5 Z</Geometry>
        <!-- Four rounded squares: the pinned-apps button. -->
        <Geometry x:Key="AppsGlyph">M 1.5,0 H 5.5 A 1.5,1.5 0 0 1 7,1.5 V 5.5 A 1.5,1.5 0 0 1 5.5,7 H 1.5 A 1.5,1.5 0 0 1 0,5.5 V 1.5 A 1.5,1.5 0 0 1 1.5,0 Z M 10.5,0 H 14.5 A 1.5,1.5 0 0 1 16,1.5 V 5.5 A 1.5,1.5 0 0 1 14.5,7 H 10.5 A 1.5,1.5 0 0 1 9,5.5 V 1.5 A 1.5,1.5 0 0 1 10.5,0 Z M 1.5,9 H 5.5 A 1.5,1.5 0 0 1 7,10.5 V 14.5 A 1.5,1.5 0 0 1 5.5,16 H 1.5 A 1.5,1.5 0 0 1 0,14.5 V 10.5 A 1.5,1.5 0 0 1 1.5,9 Z M 10.5,9 H 14.5 A 1.5,1.5 0 0 1 16,10.5 V 14.5 A 1.5,1.5 0 0 1 14.5,16 H 10.5 A 1.5,1.5 0 0 1 9,14.5 V 10.5 A 1.5,1.5 0 0 1 10.5,9 Z</Geometry>
        <Geometry x:Key="PlusGlyph">M 7,0 H 9 V 7 H 16 V 9 H 9 V 16 H 7 V 9 H 0 V 7 H 7 Z</Geometry>
        <!-- Folder outline (show in Explorer). -->
        <Geometry x:Key="FolderGlyph">M 0.8,2.2 C 0.8,1.4 1.4,0.8 2.2,0.8 L 5.6,0.8 L 7.2,2.6 L 13.8,2.6 C 14.6,2.6 15.2,3.2 15.2,4 L 15.2,11.6 C 15.2,12.4 14.6,13 13.8,13 L 2.2,13 C 1.4,13 0.8,12.4 0.8,11.6 Z M 0.8,4.6 L 15.2,4.6</Geometry>
        <!-- Bell (fallback when a notification has no app icon). -->
        <Geometry x:Key="BellGlyph">M 8,0 C 5,0 3.2,2 3.2,4.8 L 3.2,9 L 1,12 L 15,12 L 12.8,9 L 12.8,4.8 C 12.8,2 11,0 8,0 Z M 6,13 C 6,14.4 6.9,15.4 8,15.4 C 9.1,15.4 10,14.4 10,13 Z</Geometry>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="999" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The black hole's colors, matching the app icon. -->
        <LinearGradientBrush x:Key="HoleRingBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFBF5AF2" Offset="0" />
            <GradientStop Color="#FF5E5CE6" Offset="0.5" />
            <GradientStop Color="#005E5CE6" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="OneLine" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </Window.Resources>

    <!-- The notch. Its outline (flush with the top edge, flared top corners, rounded bottom)
         is rebuilt every animation frame in code-behind; content is clipped to it. -->
    <Grid x:Name="Notch" VerticalAlignment="Top"
          MouseEnter="Notch_MouseEnter" MouseLeave="Notch_MouseLeave"
          MouseLeftButtonUp="Notch_MouseLeftButtonUp"
          AllowDrop="True" DragEnter="Notch_DragEnter" DragOver="Notch_DragOver" DragLeave="Notch_DragLeave" Drop="Notch_Drop">

        <Path x:Name="NotchShape" Fill="Black" />

        <Grid x:Name="NotchContent">

            <!-- Closed, media playing: artwork left of the notch, bars on the right. -->
            <Grid x:Name="ClosedMedia" Width="290" Height="32" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Opacity="0" IsHitTestVisible="False">
                <Border x:Name="ClosedArt" Width="20" Height="20" CornerRadius="5" Margin="13,0,0,0"
                        HorizontalAlignment="Left" Background="{StaticResource ArtPlaceholder}" />
                <controls:Equalizer x:Name="ClosedEq" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                    BarWidth="2.5" BarHeight="13" BarSpacing="2.2" />
            </Grid>

            <!-- Sneak peek when a new song starts. -->
            <TextBlock x:Name="PeekText" Width="262" Margin="0,33,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                       Style="{StaticResource OneLine}" TextAlignment="Center" FontSize="12" Foreground="White"
                       Opacity="0" IsHitTestVisible="False" />

            <!-- Closed, windows waiting inside the black hole. -->
            <Grid x:Name="ClosedVault" Width="250" Height="32" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Opacity="0" IsHitTestVisible="False">
                <Ellipse Width="12" Height="12" StrokeThickness="2.2" Stroke="{StaticResource HoleRingBrush}"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="17,0,0,0" />
                <TextBlock x:Name="ClosedVaultCount" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" />
            </Grid>

            <!-- Closed, a download in progress (animated arrow + percent/count). -->
            <Grid x:Name="ClosedDownload" Width="250" Height="32" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Opacity="0" IsHitTestVisible="False">
                <Path x:Name="DownloadArrow" Data="{StaticResource DownloadGlyph}" Fill="#30D158" Width="13" Height="13"
                      Stretch="Uniform" HorizontalAlignment="Left" Margin="17,0,0,0" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="DownloadArrowT" />
                    </Path.RenderTransform>
                </Path>
                <TextBlock x:Name="ClosedDownloadText" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" />
            </Grid>

            <!-- A download just started: an arrow drops into a tray while a ring pulses out. No words. -->
            <Grid x:Name="DownloadBurstContent" Width="210" Height="60" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Opacity="0" IsHitTestVisible="False">
                <Grid Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                    <Ellipse x:Name="BurstRing" Width="40" Height="40" Stroke="#30D158" StrokeThickness="2"
                             RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="BurstRingScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="34" Height="34" Fill="#2630D158" />
                    <Canvas Width="16" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                        <Path x:Name="BurstArrow" Data="M 5.5,0 L 10.5,0 L 10.5,7 L 15,7 L 8,14 L 1,7 L 5.5,7 Z" Fill="#30D158">
                            <Path.RenderTransform>
                                <TranslateTransform x:Name="BurstArrowT" />
                            </Path.RenderTransform>
                        </Path>
                        <Rectangle Canvas.Top="17" Width="16" Height="2.5" RadiusX="1.2" RadiusY="1.2" Fill="#30D158" />
                    </Canvas>
                </Grid>
            </Grid>

            <!-- A system notification, shown briefly with a smooth entrance. -->
            <Grid x:Name="NotificationContent" Width="460" Height="82" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Opacity="0" IsHitTestVisible="False" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="NotifIconHost" Width="44" Height="44" CornerRadius="11" Margin="18,0,0,0"
                        VerticalAlignment="Center" Background="{StaticResource ArtPlaceholder}">
                    <Grid>
                        <Path x:Name="NotifBell" Data="{StaticResource BellGlyph}" Fill="{StaticResource SecondaryText}"
                              Width="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="NotifIcon" Width="30" Height="30" Stretch="Uniform" />
                    </Grid>
                </Border>
                <!-- Hover highlight: says "click me". -->
                <Border x:Name="NotifHover" Grid.ColumnSpan="2" Margin="8,6,8,6" CornerRadius="18" Background="#12FFFFFF"
                        Opacity="0" IsHitTestVisible="False" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,20,0">
                    <TextBlock x:Name="NotifApp" FontSize="10.5" Foreground="{StaticResource TertiaryText}"
                               Style="{StaticResource OneLine}" />
                    <TextBlock x:Name="NotifTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="White"
                               Style="{StaticResource OneLine}" Margin="0,1,0,0" />
                    <TextBlock x:Name="NotifBody" FontSize="11.5" Foreground="{StaticResource SecondaryText}"
                               Style="{StaticResource OneLine}" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>

            <!-- A window is being dragged toward the island. -->
            <Grid x:Name="BlackHoleContent" Width="440" Height="96" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Grid Width="28" Height="28">
                        <Ellipse Width="14" Height="14" Fill="Black" />
                        <Ellipse StrokeThickness="2.5" Stroke="{StaticResource HoleRingBrush}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="HoleSpin" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="HoleText" Text="Drop to absorb" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="It'll wait here. Hover the island to get it back." Foreground="{StaticResource TertiaryText}"
                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" />
            </Grid>

            <!-- Open. -->
            <!-- The shelf row sits below the notch's normal open height, so it's only revealed
                 (the notch grows taller) when windows are inside. -->
            <Grid x:Name="OpenContent" Width="640" Height="520" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="168" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Downloads (shown while something is downloading) -->
                <Grid x:Name="DownloadsSection" Grid.Row="2" Margin="26,0,26,10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Height="1" Background="#14FFFFFF" VerticalAlignment="Top" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <Path Data="{StaticResource DownloadGlyph}" Fill="#30D158" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Downloads" FontSize="11" FontWeight="SemiBold" Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="DownloadsCount" FontSize="11" Foreground="{StaticResource TertiaryText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Clear finished downloads from the island (files stay where they are). -->
                    <Button x:Name="ClearDownloadsButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,3"
                            Cursor="Hand" Focusable="False" Click="ClearDownloads_Click" ToolTip="Clear finished downloads">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#14FFFFFF" CornerRadius="6" Padding="8,2,8,3">
                                    <TextBlock x:Name="Label" Text="Clear" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryText}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#2AFFFFFF" />
                                        <Setter TargetName="Label" Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel x:Name="DownloadsPanel" Grid.Row="1" />
                </Grid>

                <!-- Black hole shelf -->
                <Grid x:Name="ShelfSection" Grid.Row="3" Margin="26,0,26,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Height="1" Background="#14FFFFFF" VerticalAlignment="Top" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <Ellipse Width="10" Height="10" StrokeThickness="2" Stroke="{StaticResource HoleRingBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Black hole" FontSize="11" FontWeight="SemiBold" Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShelfCount" FontSize="11" Foreground="{StaticResource TertiaryText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Click to restore · drag out to place" FontSize="10" Foreground="{StaticResource TertiaryText}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                    <ScrollViewer x:Name="ShelfScroll" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ShelfScroll_PreviewMouseWheel">
                        <StackPanel x:Name="ShelfPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                </Grid>

                <!-- Header: source app on the left, battery on the right (the middle is "the notch"). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,4,0,0">
                    <controls:Equalizer x:Name="OpenEq" BarWidth="2.5" BarHeight="11" BarSpacing="2" VerticalAlignment="Center" />
                    <TextBlock x:Name="SourceText" FontSize="11" Foreground="{StaticResource SecondaryText}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Search & play (opens the in-island YouTube panel). -->
                <!-- Looks like a search engine's search box: a clean rounded rectangle with a thin
                     outline, the magnifier on the left and a placeholder. -->
                <Button x:Name="SearchButton" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                        Width="250" Height="28"
                        Cursor="Hand" Focusable="False" Click="SearchButton_Click" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                    CornerRadius="8" Padding="10,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Glyph" Data="{StaticResource SearchGlyph}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.6"
                                          Width="12" Height="12" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Search &amp; play" Foreground="{StaticResource SecondaryText}"
                                               FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#4DFFFFFF" />
                                    <Setter TargetName="Glyph" Property="Stroke" Value="White" />
                                    <Setter TargetName="Placeholder" Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,24,0">
                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0" Visibility="Collapsed">
                    <TextBlock x:Name="BatteryText" FontSize="11" Foreground="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Border Width="23" Height="11.5" CornerRadius="3.5" BorderBrush="#73FFFFFF" BorderThickness="1" Padding="1.5"
                            VerticalAlignment="Center">
                        <Border x:Name="BatteryFill" HorizontalAlignment="Left" CornerRadius="1.8" Background="White" Width="10" />
                    </Border>
                    <Border Width="1.5" Height="4" CornerRadius="0,1,1,0" Background="#73FFFFFF" VerticalAlignment="Center" Margin="1,0,0,0" />
                </StackPanel>
                <!-- Pinned apps: swaps the player for a row of the user's favorite apps. -->
                <Button x:Name="AppsButton" Style="{StaticResource TransportButton}" Width="28" Height="28" Margin="0"
                        Click="AppsButton_Click" ToolTip="Pinned apps">
                    <Path x:Name="AppsGlyphPath" Data="{StaticResource AppsGlyph}" Fill="{StaticResource SecondaryText}"
                          Width="13" Height="13" Stretch="Uniform" />
                </Button>
                </StackPanel>

                <!-- Pinned apps (shown instead of the player when the apps button is on). -->
                <Grid x:Name="AppsGrid" Grid.Row="1" Margin="20,0,20,14" Visibility="Collapsed">
                    <ScrollViewer x:Name="AppsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center" PreviewMouseWheel="AppsScroll_PreviewMouseWheel">
                        <StackPanel x:Name="AppsPanel" Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ScrollViewer>
                    <TextBlock x:Name="AppsHint" Text="Drag an app here, or click + to pin one"
                               FontSize="10.5" Foreground="{StaticResource TertiaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>

                <Grid x:Name="PlayerGrid" Grid.Row="1" Margin="26,2,26,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Click the artwork: watch the song in the island's player panel. -->
                    <Border x:Name="OpenArt" Width="112" Height="112" CornerRadius="16" VerticalAlignment="Center"
                            Background="{StaticResource ArtPlaceholder}" Cursor="Hand" ToolTip="Open in the player"
                            MouseEnter="OpenArt_MouseEnter" MouseLeave="OpenArt_MouseLeave" MouseLeftButtonUp="OpenArt_Click">
                        <Grid>
                            <Path x:Name="OpenArtGlyph" Data="{StaticResource NoteGlyph}" Fill="{StaticResource TertiaryText}"
                                  Width="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="OpenArtHover" CornerRadius="16" Background="#66000000" Opacity="0" IsHitTestVisible="False">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#E6FFFFFF"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource PlayGlyph}" Fill="Black" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                                </Border>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Player -->
                    <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{StaticResource OneLine}" Foreground="White"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="ArtistText" Style="{StaticResource OneLine}" Foreground="{StaticResource SecondaryText}"
                                   FontSize="13" Margin="0,1,0,0" />

                        <Grid x:Name="ProgressRow" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" FontSize="10" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <Grid x:Name="ProgressTrack" Grid.Column="1" Height="16" VerticalAlignment="Center" Background="#01000000" Cursor="Hand"
                                  MouseLeftButtonDown="Progress_Down" MouseMove="Progress_Move" MouseLeftButtonUp="Progress_Up">
                                <Border Height="5" Background="#2EFFFFFF" CornerRadius="2.5" VerticalAlignment="Center" />
                                <Border x:Name="ProgressFill" Height="5" Background="White" CornerRadius="2.5" HorizontalAlignment="Left" Width="0" VerticalAlignment="Center" />
                                <Ellipse x:Name="ProgressThumb" Width="11" Height="11" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="10" Foreground="{StaticResource SecondaryText}"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="Transport" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <Button Style="{StaticResource TransportButton}" Height="38" Click="Previous_Click">
                                <Path Data="{StaticResource PreviousGlyph}" Fill="White" Width="19" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource TransportButton}" Width="42" Height="42" Click="PlayPause_Click">
                                <Path x:Name="PlayPauseGlyph" Data="{StaticResource PlayGlyph}" Fill="White" Height="18" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource TransportButton}" Height="38" Click="Next_Click">
                                <Path Data="{StaticResource NextGlyph}" Fill="White" Width="19" Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <!-- Volume -->
                        <Grid x:Name="VolumeRow" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SpeakerGlyph}" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.3"
                                  Fill="{StaticResource SecondaryText}" Width="16" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                            <Grid x:Name="VolumeTrack" Grid.Column="1" Height="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                  Background="#01000000" Cursor="Hand"
                                  MouseLeftButtonDown="Volume_Down" MouseMove="Volume_Move" MouseLeftButtonUp="Volume_Up">
                                <Border Height="4" Background="#2EFFFFFF" CornerRadius="2" VerticalAlignment="Center" />
                                <Border x:Name="VolumeFill" Height="4" Background="White" CornerRadius="2" HorizontalAlignment="Left" Width="0" VerticalAlignment="Center" />
                                <Ellipse x:Name="VolumeThumb" Width="10" Height="10" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="2" Width="1" Background="#1AFFFFFF" Margin="0,14" />

                    <!-- Calendar -->
                    <StackPanel Grid.Column="3" Width="168" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MonthText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <TextBlock x:Name="WeekdayText" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,1,0,12" />
                        <UniformGrid x:Name="WeekGrid" Columns="7" Rows="2" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
