<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 targets WinForms apps; this is a WPF app that only borrows NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Light on memory and CPU (it runs all day, next to games): workstation GC without the
         background GC thread, no runtime profiling of hot code. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>

    <Version>0.8.0</Version>
    <Product>Dynamic Island</Product>
    <!-- Shown as the app name in Task Manager and Settings › Apps › Startup. -->
    <AssemblyTitle>Dynamic Island</AssemblyTitle>
    <Company>Nazim Abderahman</Company>
    <Description>A Dynamic Island for Windows.</Description>
    <Copyright>Copyright (c) 2026 Nazim Ferragh. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon.ico" Link="Assets\icon.ico" />
    <!-- Ad blocking/skipping for the island's YouTube panel (injected into the page). -->
    <EmbeddedResource Include="Overlays\YouTubeAdBlock.js" LogicalName="YouTubeAdBlock.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
